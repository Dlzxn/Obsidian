		{"id":"9757f260869fcf78","x":-580,"y":-140,"width":250,"height":60,"color":"1","type":"text","text":"УВЕДОМЛЕНИЕ О ПОКУПКЕ ПРИХОДИТ "},
		{"id":"d4e3223cda040060","x":-120,"y":-280,"width":250,"height":420,"type":"text","text":"ПРОСМАТРИВАЕМ TYPE ТОВАРА(ИЛИ ПО ID) И ОТПРАЛЯЕМ POST ЗАПРОСОМ, ГДЕ ПЕРЕДАЕМ В ПАРАМЕТРЕ ТИП ИНФОРМАЦИИ, в responce получаем ссылку на активацию товара в тг"},
		{"id":"3943a31bcda94d8b","x":300,"y":-130,"width":250,"height":150,"type":"text","text":"РЕВЬЮШИМ ПОЛУЧЕННЫЕ ДАННЫЕ, ИЗ КОТОРЫХ СОСТАВЛЯЕМ КРАСИВОЕ ПИСЬМО В STRING"},
		{"id":"33915b16324232d0","x":760,"y":-140,"width":250,"height":180,"color":"3","type":"text","text":"ОТПРАВЛЯЕМ ЗАПРОС НА СЕРВЕРА ЯНДЕКСА ДЛЯ ОТПРАВКИ КЛЮЧ-ССЫЛКИ"},
		{"id":"504f70064a2c012d","x":760,"y":240,"width":250,"height":200,"type":"text","text":"ОТПРАВЛЯЕМ В  ASYNCIO.SLEEP(N) И ЧЕРЕЗ N СЕКУНД ПРОВЕРЯЕМ СТАТУС ЗАКАЗА(ДОЛЖЕН БЫТЬ \"ВЫПОЛНЕНО\")\nОЖИДАЕМОЕ N = 1000"},
		{"id":"ef9363b076cefbd1","x":760,"y":-520,"width":250,"height":180,"type":"text","text":"ЖДЕМ РЕСПОНС, КОТОРЫЙ ПОДТВЕРДИТ ОТПРАВКУ ПОЧТЫ"}
